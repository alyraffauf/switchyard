{
  "manifest_version": 3,
  "name": "Switchyard",
  "description": "Open the current page in Switchyard for browser selection",
  "version": "0.16.3",
  "homepage_url": "https://github.com/alyraffauf/Switchyard",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging"],
  "background": {
    "service_worker": "build/background.js"
  },
  "key": "",
  "icons": {
    "16": "icons/switchyard-16.png",
    "48": "icons/switchyard-48.png",
    "128": "icons/switchyard-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/switchyard-16.png",
      "48": "icons/switchyard-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "switchyard@alyraffauf.github.io" }
  }
}
