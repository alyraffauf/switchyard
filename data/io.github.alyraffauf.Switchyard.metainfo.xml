<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>io.github.alyraffauf.Switchyard</id>

  <name>Switchyard</name>
  <summary>Rules-based browser launcher</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.0" />

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <developer id="io.github.alyraffauf">
    <name>Aly Raffauf</name>
  </developer>

  <provides>
    <binary>switchyard</binary>
    <mediatype>x-scheme-handler/http</mediatype>
    <mediatype>x-scheme-handler/https</mediatype>
    <mediatype>x-scheme-handler/switchyard</mediatype>
  </provides>

  <url type="homepage">https://switchyard.aly.codes/</url>
  <url type="bugtracker">https://github.com/alyraffauf/switchyard/issues</url>
  <url type="vcs-browser">https://github.com/alyraffauf/switchyard</url>
  <url type="donation">https://ko-fi.com/alyraffauf</url>

  <description>
    <p>
      Switchyard puts you in control of where links open and what they open. Work links go to Chrome, personal links to Firefox. You decide the rules.
    </p>
    <p>
      Create rules using simple domain, keyword, wildcard, or regex matching. Combine conditions for precise control. Strip tracking parameters or redirect to privacy-friendly alternatives before links even open. Set it once and forget it.
    </p>
  </description>

  <launchable
        type="desktop-id"
    >io.github.alyraffauf.Switchyard.desktop</launchable>

